#!/bin/sh
# fleetctl — agnostic AiMesh fleet orchestration for Asuswrt-Merlin.
#
# Runs ON the main router (the AiMesh controller) and fans work out to the mesh
# nodes over SSH: discover them, check them, run commands, push files, install
# addons. It knows nothing about any specific addon.
#
# TRUST MODEL (the load-bearing design decision):
#   The USER prepares the trust; fleetctl only CONSUMES it. Credentials are
#   referenced from the config (FLEET_KEY, user=, auth=) — fleetctl does not
#   install, authorize, or manage them anywhere on any system. The operator
#   pastes their public key into the router GUI's SSH authorized-keys field
#   once, and AiMesh syncs that field byte-for-byte to every node, current and
#   future. Zero per-node steps, and the password escape hatch is untouched.
#
#   The single exception is `keygen`, which is never run for you (not by the
#   installer, not by another verb): it writes a keypair into fleetctl's OWN
#   directory and prints the public half. It authorizes nothing. Point
#   FLEET_KEY at a key you already have and you never need it at all.
#
# NON-GOALS (stated so they cannot drift):
#   - fleetctl NEVER writes sshd_authkeys or any AiMesh-synced / security-
#     relevant nvram, on this router or on a node. It does not add public keys
#     to any authorized_keys file, set any password, or read one from disk —
#     provisioning credentials is the operator's job, outside this tool.
#   - fleetctl NEVER restarts cfg_client / cfg_server. Corrupted cfg-sync is
#     unrecoverable for a non-expert user; breaking the mesh is not an
#     acceptable failure mode for an orchestration tool.
#   - fleetctl is not addon-aware. Rollout, upgrade, fleet state and rollback
#     are all the generic verbs (`install`, re-run `install`, `run`,
#     `install <url> uninstall`).
#
# Usage: fleetctl [global flags] <verb> [args]   — see the bottom of this file.
VERSION=0.2.0
TAG=fleetctl
REPO_RAW="https://raw.githubusercontent.com/deviationist/asuswrt-merlin-fleetctl/main"
UPDATE_TMP=/tmp/fleetctl.update.sh          # transient installer copy for 'update' (RAM)

# --- where are we running? ------------------------------------------------
# fleetctl runs BOTH on the router (the AiMesh controller, orchestrating its
# own mesh) and on a workstation (orchestrating the mesh over the LAN/VPN).
# Almost everything is identical; what differs is where config lives, how keys
# are generated, and whether `self` is a plausible install target.
#
# Detection is `[ -d /jffs ]`, NOT `which nvram`: macOS ships its own
# /usr/sbin/nvram (Apple's, unrelated), so probing for the binary would
# misidentify every Mac as a router. Asking nvram for an ASUS-only variable is
# the confirmation.
if [ -n "${FLEETCTL_PLATFORM:-}" ]; then
  PLATFORM=$FLEETCTL_PLATFORM            # override = testability (both branches)
elif [ -d /jffs ] && [ -n "$(nvram get productid 2>/dev/null)" ]; then
  PLATFORM=router
else
  PLATFORM=workstation
fi
if [ "$PLATFORM" = "router" ]; then
  CONFDIR=/jffs/scripts
  DEF_HOME=/jffs/scripts/fleetctl.d      # our own known_hosts (see _detect_ssh)
else
  CONFDIR="${XDG_CONFIG_HOME:-$HOME/.config}/fleetctl"
  DEF_HOME=""                            # use the user's real ~/.ssh — see below
fi
# FLEETCTL_* overrides = testability (the suite drives the REAL script; nothing
# below is a test-only code path) and, for CONF, "keep several fleets".
CONF="${FLEETCTL_CONF:-$CONFDIR/fleetctl.conf}"
FLEET_HOME="${FLEETCTL_HOME:-$DEF_HOME}"
FLEET_JFFS="${FLEETCTL_JFFS:-/jffs/scripts}"   # probed path; overridable for tests

# --- defaults (defined BEFORE sourcing the conf so the conf can override) ---
FLEET_NODES=""                        # explicit node specs — the runtime source of truth
FLEET_CONTROLLER=""                   # where 'discover' asks; empty => self on a router
FLEET_USER=""                         # empty => nvram http_username on a router; else
                                      # unset, so ~/.ssh/config decides (workstation)
FLEET_PORT=""                         # empty => nvram sshd_port, else 22
FLEET_KEY="$CONFDIR/fleetctl.key"     # must not contain spaces (see _ssh_opts)
FLEET_ALLOW_PASSWORD=0                # 1 = permit the discouraged password fallback
FLEET_STRICT_HOSTKEY=0                # 1 = never auto-accept an unknown host key
FLEET_PROBE_TIMEOUT=20                # seconds, per-node identity/eligibility probe
FLEET_RUN_TIMEOUT=120                 # seconds, per-node `run`
FLEET_INSTALL_TIMEOUT=600             # seconds, per-node `install` (downloads + install)
[ -f "$CONF" ] && . "$CONF"

# On a router the admin identity is known (and AiMesh-synced mesh-wide), so it
# is a good default. On a workstation an EMPTY user is deliberate: fleetctl then
# connects as plain `host`, letting the operator's existing ~/.ssh/config supply
# user, port, and key — so `FLEET_NODES="router"` works with no fleetctl config
# at all if that Host block already exists.
if [ "$PLATFORM" = "router" ]; then
  [ -n "$FLEET_USER" ] || FLEET_USER=$(nvram get http_username 2>/dev/null)
  [ -n "$FLEET_USER" ] || FLEET_USER=admin
  [ -n "$FLEET_PORT" ] || FLEET_PORT=$(nvram get sshd_port 2>/dev/null)
  [ -n "$FLEET_CONTROLLER" ] || FLEET_CONTROLLER=self
fi
[ -n "$FLEET_PORT" ] || FLEET_PORT=22

# --- global flags (parsed by the dispatcher at the bottom) ---
DRY_RUN=0
INCLUDE_SELF=0
ALLOW_UNPINNED=0
PORCELAIN=0
ASSUME_YES=0

# Per-node identity + eligibility, in ONE round trip. The __fleetprobe__ token
# marks OUR line so a login banner can't be mistaken for the answer. An empty
# model means "nvram did not answer" — i.e. not an ASUS unit at all, which is
# a hard stop for anything mutating (see _require_target).
PROBE='m=""; for v in lan_hwaddr label_mac et0macaddr et1macaddr; do x=$(nvram get $v 2>/dev/null); [ -n "$x" ] && m="$m$x,"; done; [ -d '"$FLEET_JFFS"' ] && d=yes || d=no; echo "__fleetprobe__ v=1 model=$(nvram get productid 2>/dev/null | tr " " "_") jffs=$(nvram get jffs2_scripts 2>/dev/null) dir=$d on=$(nvram get jffs2_on 2>/dev/null) macs=$m"'

die()  { echo "ERROR: $1" >&2; exit 1; }
warn() { echo "warn: $1" >&2; }

# --- single-instance lock ---------------------------------------------------
# Two overlapping fan-outs (impatient user, or manual racing cron) writing the
# same node's /jffs/scripts is a corruption path. `flock` exists on SOME builds
# (present on RT-BE92U 3006) but not universally — mkdir is the portable
# atomic-create primitive, so that is what we use. Stale locks are reclaimed by
# checking /proc for the recorded pid (never by `ps | grep`: a broad ps match
# would match the caller's own SSH session — a real, previously-shipped bug in
# this project family).
LOCKDIR="${FLEETCTL_LOCK:-/tmp/fleetctl.lock}"   # env override = testability
LOCKED=0
_lock() {
  if mkdir "$LOCKDIR" 2>/dev/null; then LOCKED=1; echo $$ > "$LOCKDIR/pid"; return 0; fi
  _op=$(cat "$LOCKDIR/pid" 2>/dev/null)
  # Liveness via `kill -0` (POSIX, no applet needed) rather than /proc, so the
  # check also works where /proc is absent. /proc, when present, additionally
  # rules out pid REUSE — a recycled pid would otherwise look like a live
  # fleetctl forever. Never `ps | grep`: a broad match would match the caller's
  # own SSH session.
  if [ -n "$_op" ] && kill -0 "$_op" 2>/dev/null; then
    if [ ! -r "/proc/$_op/cmdline" ] || grep -q fleetctl "/proc/$_op/cmdline" 2>/dev/null; then
      die "another fleetctl is already running (pid $_op). Wait for it, or remove $LOCKDIR if you are sure it is dead."
    fi
  fi
  warn "clearing a stale lock from pid ${_op:-unknown}"
  rm -rf "$LOCKDIR"
  mkdir "$LOCKDIR" 2>/dev/null || die "could not take the lock at $LOCKDIR"
  LOCKED=1; echo $$ > "$LOCKDIR/pid"
}
TMPBASE="/tmp/fleetctl.$$"
_cleanup() { [ "$LOCKED" = "1" ] && rm -rf "$LOCKDIR"; rm -f "$TMPBASE".*; }
trap _cleanup EXIT INT TERM

# --- node specs -------------------------------------------------------------
# A node spec is one whitespace-free token:
#
#   [user@]host[:port][,key=value]...
#
# host may be an IP or a hostname (or [v6addr]). Recognised key=value fields:
#   port=  user=  key=<identity file>  auth=pass|key  mac=<pin>  name=<label>
#
# Everything is optional; anything omitted inherits the conf defaults. This is
# ONE list rather than a list plus a side table, because a fan-out tool with
# two sources of truth for "who is in the fleet" is a foot-gun.
_parse_spec() {
  _s=$1
  SPEC_RAW=$_s
  SPEC_USER=$FLEET_USER; SPEC_PORT=$FLEET_PORT; SPEC_KEY=""; SPEC_AUTH=""
  SPEC_MAC=""; SPEC_NAME=""; SPEC_LOCAL=0
  # trailing key=value fields
  case "$_s" in
    *,*) _fields=${_s#*,}; _s=${_s%%,*} ;;
    *)   _fields="" ;;
  esac
  case "$_s" in *@*) SPEC_USER=${_s%@*}; _s=${_s##*@} ;; esac
  case "$_s" in
    \[*\]:*) SPEC_PORT=${_s##*]:}; _s=${_s%%]:*}; _s=${_s#[} ;;   # [v6]:port
    \[*\])   _s=${_s#[}; _s=${_s%]} ;;                            # [v6]
    *:*:*)   : ;;                                                 # bare v6, no port
    *:*)     SPEC_PORT=${_s##*:}; _s=${_s%:*} ;;
  esac
  SPEC_HOST=$_s
  # `self` (alias `local`) targets THIS machine, executed directly instead of
  # over SSH — no hop, and no requirement that the unit authorize its own key.
  # Listing it in FLEET_NODES is itself the opt-in, so it is not subject to the
  # --include-self guard (that guard exists for a node whose ADDRESS happens to
  # resolve to the controller, which is a different, accidental case).
  case "$SPEC_HOST" in
    self|local) SPEC_LOCAL=1; SPEC_NAME=self ;;
  esac
  if [ -n "$_fields" ]; then
    for _f in $(echo "$_fields" | tr ',' ' '); do
      case "$_f" in
        port=*) SPEC_PORT=${_f#port=} ;;
        user=*) SPEC_USER=${_f#user=} ;;
        key=*)  SPEC_KEY=${_f#key=} ;;
        auth=*) SPEC_AUTH=${_f#auth=} ;;
        mac=*)  SPEC_MAC=$(echo "${_f#mac=}" | tr 'a-z' 'A-Z') ;;
        name=*) SPEC_NAME=${_f#name=} ;;
        '')     : ;;
        *)      warn "$SPEC_RAW: ignoring unknown field '$_f'" ;;
      esac
    done
  fi
  [ -n "$SPEC_NAME" ] || SPEC_NAME=$SPEC_HOST
  # auth resolution: an explicit per-node key/auth wins, else the conf default.
  SPEC_PASS=0
  case "$SPEC_AUTH" in
    pass|password) SPEC_PASS=1 ;;
    key|'')        : ;;
    *)             SPEC_KEY=$SPEC_AUTH ;;   # tolerate auth=<path> as a key path
  esac
  if [ "$SPEC_LOCAL" = "1" ]; then
    SPEC_PASS=0; SPEC_KEY=""            # nothing to authenticate to
  elif [ "$SPEC_PASS" = "0" ] && [ -z "$SPEC_KEY" ]; then
    if [ -f "$FLEET_KEY" ]; then SPEC_KEY=$FLEET_KEY
    elif [ "$FLEET_ALLOW_PASSWORD" = "1" ]; then SPEC_PASS=1
    fi
    # On a workstation, no key is not an error: OpenSSH may authenticate from
    # ~/.ssh/config or an agent. We simply pass no -i and let it decide.
  fi
}

# --- password fallback (opt-in, discouraged, never stored) -------------------
# Prompted once per distinct password scope, kept in this process's memory
# only. Storing it would put a plaintext mesh-admin credential on flash.
_have_tty() { ( : < /dev/tty ) 2>/dev/null; }
_password_for() {
  # Reached only when the spec resolved to password auth AND that was permitted
  # (_probe rejects the mismatch per node, so this is not a second gate).
  _slot="FLEET_PW_$(echo "$1" | sed 's/[^A-Za-z0-9]/_/g')"
  eval "_pw=\${$_slot:-}"
  if [ -z "$_pw" ]; then
    # Never block waiting for input that can never arrive: a cron-driven or
    # piped invocation has no TTY, and a prompt there would hang forever.
    _have_tty || die "password auth needs a terminal, and this invocation has no TTY (cron/pipe?). Use key auth: fleetctl keygen"
    echo "FLEET_ALLOW_PASSWORD — using password auth for $1. This is the discouraged path:" >&2
    echo "  the mesh admin password transits process environments on every hop." >&2
    echo "  Set up the key instead; it is one paste: fleetctl keygen" >&2
    printf 'password for %s@%s: ' "$SPEC_USER" "$1" >&2
    # stty acts on ITS stdin — redirect it, or a piped invocation silently echoes
    stty -echo < /dev/tty 2>/dev/null
    read -r _pw < /dev/tty
    stty echo < /dev/tty 2>/dev/null
    echo >&2
    eval "$_slot=\$_pw"
  fi
  DROPBEAR_PASSWORD=$_pw; export DROPBEAR_PASSWORD
}

# --- SSH transport ----------------------------------------------------------
# busybox applet sets are trimmed and vary per build: probe with `which` (this
# busybox has NO `command` builtin — `command -v` fails with "command: not
# found", a false negative that reads as "missing"). Same discipline for
# dbclient's OWN flags: an unknown flag makes dbclient exit before connecting,
# so -K/-M are used only if this build advertises them.
SSH_BIN=""; SSH_FLAVOR=""; DB_HAS_K=0; DB_HAS_M=0
_detect_ssh() {
  [ -n "$SSH_BIN" ] && return 0
  if which dbclient >/dev/null 2>&1; then SSH_BIN=dbclient; SSH_FLAVOR=dropbear
  elif which ssh >/dev/null 2>&1; then
    SSH_BIN=ssh
    # On Merlin `ssh` IS dropbear; only Entware/OpenSSH announces itself.
    if ssh -V 2>&1 | grep -qi openssh; then SSH_FLAVOR=openssh; else SSH_FLAVOR=dropbear; fi
  else
    return 1
  fi
  if [ "$SSH_FLAVOR" = "dropbear" ]; then
    _h=$("$SSH_BIN" -h 2>&1)
    echo "$_h" | grep -q '^-K ' && DB_HAS_K=1     # keepalive => dead peers are noticed
    echo "$_h" | grep -q '^-M ' && DB_HAS_M=1     # in-client max session duration
  fi
  # ROUTER ONLY: keep TOFU state in fleetctl's own known_hosts rather than
  # root's. It lives on /jffs because it must survive reboots — a few hundred
  # bytes, written once per node, within the flash-wear rule. dropbear finds it
  # via $HOME, so HOME is repointed for this whole process (a `HOME=x func`
  # prefix would NOT be reliably scoped: POSIX leaves assignments before a
  # function call persisting in the shell, so scoping it that way only looks
  # local).
  #
  # On a WORKSTATION we deliberately do NOT do this: repointing HOME would hide
  # the operator's ~/.ssh/config, agent and keys — the very things that make
  # `FLEET_NODES="router"` work with no fleetctl config at all. There, ordinary
  # OpenSSH known_hosts + StrictHostKeyChecking=accept-new give the same TOFU.
  if [ -n "$FLEET_HOME" ]; then
    [ -d "$FLEET_HOME/.ssh" ] || mkdir -p "$FLEET_HOME/.ssh" 2>/dev/null
    HOME="$FLEET_HOME"; export HOME
  fi
  return 0
}

# _ssh_opts <max_seconds> — NB: the result is deliberately word-split by the
# caller, so FLEET_KEY / key= paths must not contain spaces (documented).
_ssh_opts() {
  if [ "$SSH_FLAVOR" = "openssh" ]; then
    o="-p $SPEC_PORT -o ConnectTimeout=10"
    [ -n "$FLEET_HOME" ] && o="$o -o UserKnownHostsFile=$FLEET_HOME/.ssh/known_hosts"
    [ "$SPEC_PASS" = "1" ] || o="$o -o BatchMode=yes"
    [ "$FLEET_STRICT_HOSTKEY" = "1" ] || o="$o -o StrictHostKeyChecking=accept-new"
    [ -n "$SPEC_KEY" ] && [ -f "$SPEC_KEY" ] && o="$o -o IdentitiesOnly=yes -i $SPEC_KEY"
  else
    o="-T -p $SPEC_PORT"
    # TOFU: -y accepts an UNKNOWN host key and records it; a CHANGED key is
    # still fatal (that needs `-y -y`, which we never pass). On a LAN node a
    # changed key means a firmware reflash or someone spoofing the address —
    # the user must decide which, so we surface it instead of accepting it.
    [ "$FLEET_STRICT_HOSTKEY" = "1" ] || o="$o -y"
    [ "$DB_HAS_K" = "1" ] && o="$o -K 10"
    # -M is a backstop set just ABOVE our own watchdog, so the watchdog (which
    # can tell us it fired) is what normally trips, and -M only covers the case
    # where the watchdog itself fails.
    [ "$DB_HAS_M" = "1" ] && [ -n "$1" ] && o="$o -M $(($1 + 5))"
    [ -n "$SPEC_KEY" ] && [ -f "$SPEC_KEY" ] && o="$o -i $SPEC_KEY"
  fi
  echo "$o"
}

# _with_timeout <secs> <cmd...>
# There is NO `timeout` applet on this firmware (verified on RT-BE92U 3006), so
# the cap is a watchdog we run ourselves: background the child, background a
# sleeper that kills it, whichever finishes first wins. The sleeper touches a
# marker before killing so a timeout is distinguishable from an ordinary
# non-zero exit. Kills are by known pid ONLY — never by `ps | grep`, which
# would match the caller's own SSH session.
#
# RUN_STDIN is why the child's stdin is passed EXPLICITLY: POSIX gives an
# asynchronous ("&") command /dev/null as stdin unless it is explicitly
# redirected. Without this, `push` would happily stream nothing and write an
# empty file over the destination on every node — silently, exit 0. Caught by
# the test suite; do not "simplify" it away.
TIMED_OUT=0
RUN_STDIN=/dev/null
_with_timeout() {
  _cap=$1; shift
  _mark="$TMPBASE.timedout"; rm -f "$_mark"; TIMED_OUT=0
  "$@" < "$RUN_STDIN" &
  _cpid=$!
  # The sleeper's output MUST be detached from ours. A background child inherits
  # the parent's stdout, and a command substitution — `raw=$(_run_on …)`, as
  # discovery uses — does not return until every writer to that pipe closes it.
  # Without this redirect the watchdog holds the pipe for its full duration, so
  # a call that already succeeded still blocks for the whole timeout (a 20 s
  # stall on every `discover`). Caught by running the suite under dash.
  #
  # PID-REUSE GUARD: there is a narrow window where the child exits just as the
  # sleeper wakes, the kernel recycles its pid, and the sleeper kills whatever
  # inherited it. On a production router that could be any process. So the
  # sleeper re-checks /proc/<pid>/cmdline still looks like the thing we
  # launched before signalling. Where /proc is absent the check is skipped —
  # the router has /proc, which is where this matters.
  _what=$1
  ( sleep "$_cap"
    if [ -r "/proc/$_cpid/cmdline" ]; then
      tr '\0' ' ' < "/proc/$_cpid/cmdline" 2>/dev/null | grep -q "$_what" || exit 0
    fi
    kill "$_cpid" 2>/dev/null && : > "$_mark" ) >/dev/null 2>&1 &
  _wpid=$!
  wait "$_cpid"; _rc=$?
  kill "$_wpid" 2>/dev/null
  wait "$_wpid" 2>/dev/null
  [ -f "$_mark" ] && { TIMED_OUT=1; rm -f "$_mark"; }
  return $_rc
}

# _run_on <max_seconds> <command-string>   (uses the SPEC_* of the current node)
_run_on() {
  _cap=$1
  # `self`: run it here. Same watchdog, same stdin handling, same result
  # accounting — only the transport differs, so every gate and every summary
  # line behaves identically whether a target is local or remote.
  if [ "$SPEC_LOCAL" = "1" ]; then
    _with_timeout "$_cap" sh -c "$2"
    return $?
  fi
  _detect_ssh || die "no SSH client found (looked for dbclient, ssh)"
  [ "$SPEC_PASS" = "1" ] && _password_for "$SPEC_HOST"
  # An empty user means "let ~/.ssh/config decide" (workstation default), so the
  # target is passed as a bare host rather than as `@host`.
  if [ -n "$SPEC_USER" ]; then _tgt="$SPEC_USER@$SPEC_HOST"; else _tgt="$SPEC_HOST"; fi
  # shellcheck disable=SC2086  — word splitting of the option list is intended
  _with_timeout "$_cap" "$SSH_BIN" $(_ssh_opts "$_cap") "$_tgt" "$2"
}

# The LAN's default gateway — the first guess at "where is the router?".
# Portable across the three route tools we can expect (iproute2 on Linux,
# BSD/macOS `route`, `netstat` anywhere). Each is probed with `which` first,
# because assuming an applet exists is how this project breaks. If none of
# them are present we simply return nothing and the caller falls back to
# explicit config — a guess is never load-bearing here.
_default_gateway() {
  _gw=""
  if which ip >/dev/null 2>&1; then
    _gw=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
  fi
  if [ -z "$_gw" ] && which route >/dev/null 2>&1; then
    _gw=$(route -n get default 2>/dev/null | awk '/gateway:/{print $2; exit}')
  fi
  if [ -z "$_gw" ] && which netstat >/dev/null 2>&1; then
    _gw=$(netstat -rn 2>/dev/null | awk '/^(default|0\.0\.0\.0)/{print $2; exit}')
  fi
  echo "$_gw"
}

# Ask a candidate host whether it is an ASUS unit that knows a mesh. Read-only
# (two nvram reads), and its answer is only ever used to SUGGEST a controller —
# never to authorize anything. Sets AUTO_MODEL / AUTO_REASON.
_looks_like_controller() {
  AUTO_MODEL=""; AUTO_REASON=""
  _parse_spec "$1"
  if ! _probe; then AUTO_REASON="$P_REASON"; return 1; fi
  if [ -z "$P_MODEL" ]; then AUTO_REASON="answered SSH, but did not identify as an ASUS unit"; return 1; fi
  AUTO_MODEL=$P_MODEL
  return 0
}

# How this target is being reached, for the per-node headers.
_target_desc() {
  if [ "$SPEC_LOCAL" = "1" ]; then echo "this machine, run locally"
  elif [ -n "$SPEC_USER" ]; then echo "$SPEC_USER@$SPEC_HOST:$SPEC_PORT"
  else echo "$SPEC_HOST (via ~/.ssh/config)"
  fi
}

# --- probe / identity -------------------------------------------------------
# Sets: P_OK P_MODEL P_JFFS P_DIR P_MACS P_REASON
_probe() {
  P_OK=0; P_MODEL=""; P_JFFS=""; P_DIR=""; P_ON=""; P_MACS=""; P_REASON=""
  # A per-node auth mismatch is that NODE's problem, not grounds to abort the
  # whole fan-out (continue-on-error: a half-run mesh with no record of where
  # it stopped is worse than a full run with failures listed).
  if [ "$SPEC_PASS" = "1" ] && [ "$FLEET_ALLOW_PASSWORD" != "1" ]; then
    P_REASON="spec requests password auth, but FLEET_ALLOW_PASSWORD=0 in $CONF (key auth is the supported path: fleetctl keygen)"
    return 1
  fi
  _err="$TMPBASE.err"; _out="$TMPBASE.probe"
  _run_on "$FLEET_PROBE_TIMEOUT" "$PROBE" > "$_out" 2> "$_err"
  _rc=$?
  if [ "$TIMED_OUT" = "1" ]; then P_REASON="timed out after ${FLEET_PROBE_TIMEOUT}s"; return 1; fi
  _line=$(grep '__fleetprobe__' "$_out" 2>/dev/null | head -1)
  if [ -z "$_line" ]; then
    if grep -qi 'host key\|HOST KEY' "$_err" 2>/dev/null; then
      P_REASON="HOST KEY MISMATCH — this address answered with a different SSH host key than last time. A firmware reflash explains it; so does someone else holding that address now. Verify, then remove the stale entry from $FLEET_HOME/.ssh/known_hosts"
    elif grep -qi 'denied\|authentication' "$_err" 2>/dev/null; then
      P_REASON="SSH auth failed (is the key pasted into the router GUI's SSH authentication key field yet?)"
    else
      P_REASON="unreachable: $(head -1 "$_err" 2>/dev/null | cut -c1-120)"
      [ "$_rc" = "0" ] && P_REASON="connected, but the probe produced no answer (is this an ASUS unit?)"
    fi
    return 1
  fi
  P_MODEL=$(echo "$_line" | tr ' ' '\n' | grep '^model=' | cut -d= -f2-)
  P_JFFS=$(echo  "$_line" | tr ' ' '\n' | grep '^jffs='  | cut -d= -f2-)
  P_DIR=$(echo   "$_line" | tr ' ' '\n' | grep '^dir='   | cut -d= -f2-)
  P_ON=$(echo    "$_line" | tr ' ' '\n' | grep '^on='    | cut -d= -f2-)
  P_MACS=$(echo  "$_line" | tr ' ' '\n' | grep '^macs='  | cut -d= -f2- | tr 'a-z' 'A-Z')
  P_OK=1
  return 0
}

# Why a unit cannot take a /jffs-touching verb — and, crucially, whether the
# user can do anything about it. VERIFIED 2026-07-28 on a stock RP-BE58 AiMesh
# node vs the Merlin controller: `jffs2_scripts` is a MERLIN-ONLY nvram
# variable. It is not set to 0 on stock firmware, it does not exist
# (`nvram show | grep -c` returns 0, vs 1 on Merlin). So:
#
#   jffs empty -> stock ASUS firmware. There is no setting to enable; the unit
#                 needs Merlin flashed, and for many AiMesh-only models no
#                 Merlin build exists at all. Permanent, not a misconfiguration.
#   jffs = 0   -> Merlin, custom scripts switched off. One GUI toggle away.
#
# Telling a stock-node owner to "enable JFFS custom scripts" sends them looking
# for a checkbox their firmware does not have — which is what this used to do.
_ineligible_reason() {
  if [ -z "$P_JFFS" ]; then
    echo "$P_MODEL is not running Asuswrt-Merlin (jffs2_scripts exists only on Merlin). Addons that install into /jffs/scripts need Merlin on that unit; several AiMesh-only models have no Merlin build, in which case this unit can never be an install target. 'run' still works on it"
  elif [ "$P_JFFS" = "0" ]; then
    echo "$P_MODEL runs Merlin but JFFS custom scripts are off — enable Administration -> System -> 'Enable JFFS custom scripts and configs' on that unit, then retry"
  else
    echo "$P_MODEL has jffs2_scripts=$P_JFFS but no $FLEET_JFFS directory (jffs2_on=${P_ON:-?})"
  fi
}

# Eligibility gate for anything that touches a node's /jffs. Verified
# signature: a STOCK (non-Merlin) AiMesh node returns an empty jffs2_scripts,
# so it is correctly reported ineligible — while remaining a perfectly good
# `run` target (stock nodes still answer nvram, wl, ...).
_eligible() { [ "$P_JFFS" = "1" ] && [ "$P_DIR" = "yes" ]; }

SELF_MACS=""
_self_macs() {
  [ -n "$SELF_MACS" ] && return 0
  for v in lan_hwaddr label_mac et0macaddr et1macaddr; do
    x=$(nvram get "$v" 2>/dev/null); [ -n "$x" ] && SELF_MACS="$SELF_MACS$x,"
  done
  SELF_MACS=$(echo "$SELF_MACS" | tr 'a-z' 'A-Z')
}
_is_self() {
  # cheap check first: our own LAN address, or the loopback aliases
  _lan=$(nvram get lan_ipaddr 2>/dev/null)
  case "$SPEC_HOST" in localhost|127.0.0.1) return 0 ;; esac
  [ -n "$_lan" ] && [ "$SPEC_HOST" = "$_lan" ] && return 0
  # then by identity, which also catches "the controller under another name"
  _self_macs
  [ -n "$P_MACS" ] && [ -n "$SELF_MACS" ] || return 1
  for m in $(echo "$P_MACS" | tr ',' ' '); do
    case ",$SELF_MACS," in *",$m,"*) return 0 ;; esac
  done
  return 1
}
_pin_matches() {
  [ -n "$SPEC_MAC" ] || return 1
  for m in $(echo "$P_MACS" | tr ',' ' '); do
    [ "$m" = "$SPEC_MAC" ] && return 0
  done
  return 1
}

# --- confirmation gate for the verbs that change a unit ---------------------
# These routers are production kit for the people who own them, and often the
# only one they have — there is no staging mesh. `install` runs SOMEONE ELSE'S
# code as root on every eligible unit; `push` overwrites files. Both therefore
# state the plan and require agreement.
#
# `run` is deliberately NOT gated: the operator typed that command themselves,
# they see it echoed, and every node's result is summarised. Prompting there
# would train people to hit `y` reflexively, which makes the prompts that do
# matter worthless.
#
# Unattended (no TTY — cron, or a consuming addon) an unconfirmed fan-out is
# REFUSED rather than assumed: --yes must be explicit. That way "it ran while
# nobody was looking" is always something the caller opted into.
_confirm_fanout() {
  [ "$DRY_RUN" = "1" ] && return 0          # dry runs change nothing
  echo
  echo "About to $1"
  echo "  on: $(echo $FLEET_NODES | tr ' ' '\n' | sed 's/,.*//' | tr '\n' ' ')"
  echo "  as: root (that is what SSH to these units gives you)"
  [ "$ASSUME_YES" = "1" ] && { echo "  --yes given, proceeding."; return 0; }
  if ! _have_tty; then
    die "refusing to fan out unattended. There is no terminal to confirm at
(cron? a script? a consuming addon?), so pass --yes if this is intended:
  fleetctl --yes $VERB ...
Or preview it safely first with --dry-run."
  fi
  printf '  Proceed? [y/N] ' >&2
  read -r _ans < /dev/tty
  case "$_ans" in
    y|Y|yes|YES) echo ;;
    *) die "aborted by operator — nothing was changed." ;;
  esac
}

# --- per-node result summary ------------------------------------------------
# A failed node must never look like a successful run: every node lands in the
# summary, and fleetctl's exit code is non-zero if any of them failed.
SUMMARY="$TMPBASE.summary"
_result() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$SUMMARY"; }
_print_summary() {
  # --porcelain is a PUBLIC CONTRACT for consuming addons (see README, "Using
  # fleetctl from your own addon"). Columns are fixed and tab-separated:
  #   fleetctl<TAB>node<TAB>OK|FAIL|SKIPPED<TAB>reason
  # Never reorder or repurpose them; add new columns at the END if you must.
  if [ "$PORCELAIN" = "1" ]; then
    [ -f "$SUMMARY" ] || return 1
    _fail=0
    while IFS="$(printf '\t')" read -r h st reason; do
      [ "$st" = "OK" ] || [ "$st" = "SKIPPED" ] || _fail=$((_fail+1))
      printf 'fleetctl\t%s\t%s\t%s\n' "$h" "$st" "$reason"
    done < "$SUMMARY"
    [ "$_fail" = "0" ]
    return $?
  fi
  echo
  echo "--- summary ---"
  [ -f "$SUMMARY" ] || { echo "  (no nodes processed)"; return 1; }
  _ok=0; _fail=0; _skip=0
  while IFS="$(printf '\t')" read -r h st reason; do
    case "$st" in
      OK)      _ok=$((_ok+1));     printf '  OK       %-18s %s\n' "$h" "$reason" ;;
      SKIPPED) _skip=$((_skip+1)); printf '  SKIPPED  %-18s %s\n' "$h" "$reason" ;;
      *)       _fail=$((_fail+1)); printf '  FAIL     %-18s %s\n' "$h" "$reason" ;;
    esac
  done < "$SUMMARY"
  echo "  ($_ok ok, $_fail failed, $_skip skipped)"
  logger -t "$TAG" "$VERB: ok=$_ok fail=$_fail skip=$_skip" 2>/dev/null
  [ "$_fail" = "0" ]
}

# _nodes_or_die — the runtime fleet, always from the conf (never from live
# discovery: a discovered list drifts, and a fan-out tool must aim at a stable,
# user-owned target list).
_nodes_or_die() {
  [ -n "$FLEET_NODES" ] && return 0
  # SINGLE-DEVICE PASSTHROUGH. A fleet of one is a legitimate (if ironic) way to
  # use a fan-out tool: a consuming addon calls `fleetctl install …` and the user
  # simply has one router. Erroring there would make the addon's mesh command
  # useless on the most common setup, so an unconfigured fleet on a router means
  # "this unit" — every gate still applies, it is just a fleet of one.
  #
  # The note goes to STDERR so --porcelain stdout stays clean for parsers, and
  # it is loud on purpose: silently acting on the controller when someone MEANT
  # to reach their mesh (typo'd conf, wrong file) would be a nasty surprise.
  if [ "$PLATFORM" = "router" ]; then
    FLEET_NODES=self
    echo "note: no FLEET_NODES configured — acting on THIS unit only (single-device mode)." >&2
    echo "      'fleetctl discover' sets up a mesh fan-out if you have one." >&2
    return 0
  fi
  die "FLEET_NODES is empty in $CONF, and this machine is not a router, so there
is nothing to act on. Run 'fleetctl discover' for a conf-ready line, or pass
--nodes '<spec> ...'."
}

# _require_target <mutating?> — shared gate: probe, identify, decide.
# Sets GATE=go|skip|fail and GATE_REASON. `run` is deliberately laxer than the
# mutating verbs: a read-only command on a re-IP'd host is a nuisance, whereas
# `curl … | sh` as root on one is a compromise.
_require_target() {
  _mut=$1; GATE=fail; GATE_REASON=""
  if ! _probe; then GATE_REASON="$P_REASON"; return 1; fi
  if [ "$SPEC_LOCAL" != "1" ] && _is_self && [ "$INCLUDE_SELF" != "1" ]; then
    GATE=skip; GATE_REASON="this is the controller itself (list it as 'self' to include it, or pass --include-self)"; return 1
  fi
  if [ "$_mut" = "1" ]; then
    if [ -z "$P_MODEL" ]; then
      if [ "$SPEC_LOCAL" = "1" ]; then
        GATE_REASON="refusing: this machine is not an ASUS router, so 'self' is not an install target here. Run fleetctl ON the unit you want to install on, or target it over SSH"
      else
        GATE_REASON="refusing: the host at this address did not identify as an ASUS unit"
      fi
      return 1
    fi
    if [ -n "$SPEC_MAC" ]; then
      if ! _pin_matches; then
        GATE_REASON="refusing: MAC pin $SPEC_MAC does not match this host ($P_MODEL). DHCP may have moved the address — re-run 'fleetctl discover'"; return 1
      fi
    elif [ "$SPEC_LOCAL" != "1" ] && [ "$ALLOW_UNPINNED" != "1" ]; then
      # A pin defends against "that address points somewhere else now". A local
      # target has no address indirection to be wrong about, so requiring one
      # there would be ceremony, not safety.
      GATE_REASON="refusing: no MAC pin for this node, and this verb runs as root on it. Add mac=… (see 'fleetctl discover'), or pass --allow-unpinned"; return 1
    fi
    if ! _eligible; then
      # A verdict without a remediation is a dead end for the user — but an
      # AiMesh node has no web UI of its own, so the honest instruction is the
      # one in the README, not a confident GUI path that does not exist.
      GATE=skip
      GATE_REASON="not Merlin-eligible: $(_ineligible_reason)"
      return 1
    fi
  fi
  GATE=go; return 0
}

# --- verbs ------------------------------------------------------------------

# `keygen` is the ONLY command that creates credential material, it is never
# run for you (not by the installer, not by another verb), and it writes only
# into fleetctl's own directory. It does not authorize the key anywhere: no
# authorized_keys, no nvram, no GUI automation. Authorizing is the operator's
# action, in the GUI, where the password escape hatch still exists.
cmd_keygen() {
  # Key generation differs by platform: dropbearkey on the router, ssh-keygen
  # on a workstation. The PUBLIC key is the same shape either way, which is all
  # the GUI field cares about.
  if which dropbearkey >/dev/null 2>&1; then KEYGEN=dropbear
  elif which ssh-keygen >/dev/null 2>&1; then KEYGEN=openssh
  else die "neither dropbearkey nor ssh-keygen found — cannot generate a key here"
  fi
  mkdir -p "$(dirname "$FLEET_KEY")" 2>/dev/null
  if [ "$PLATFORM" = "workstation" ] && [ ! -f "$FLEET_KEY" ] && [ "$1" != "--force" ]; then
    echo "note: on a workstation you may not need a fleetctl key at all — if your"
    echo "      ~/.ssh already reaches the router (an agent, or a Host block), leave"
    echo "      FLEET_KEY unset and fleetctl will let OpenSSH authenticate as usual."
    echo
  fi
  if [ -f "$FLEET_KEY" ] && [ "$1" != "--force" ]; then
    echo "Key already exists: $FLEET_KEY  (use 'fleetctl keygen --force' to replace it)"
  else
    if [ -f "$FLEET_KEY" ]; then
      echo "Replacing $FLEET_KEY — the OLD public key stays authorized until you"
      echo "remove it from the router GUI's key field. Do that after this works."
      rm -f "$FLEET_KEY" "$FLEET_KEY.pub"
    fi
    # fleetctl's OWN path — deliberately NOT /jffs/.ssh/, which holds the
    # firmware's sshd HOST keys. File creation only; no nvram is written.
    if [ "$KEYGEN" = "dropbear" ]; then
      dropbearkey -t ed25519 -f "$FLEET_KEY" >/dev/null 2>&1 ||
        dropbearkey -t rsa -s 3072 -f "$FLEET_KEY" >/dev/null 2>&1 ||
        die "key generation failed (dropbearkey)"
    else
      ssh-keygen -q -t ed25519 -N '' -C "fleetctl@$(hostname 2>/dev/null || echo workstation)" -f "$FLEET_KEY" </dev/null >/dev/null 2>&1 ||
        die "key generation failed (ssh-keygen)"
    fi
    chmod 600 "$FLEET_KEY"
    echo "Generated $FLEET_KEY"
  fi
  if [ "$KEYGEN" = "dropbear" ]; then
    pub=$(dropbearkey -y -f "$FLEET_KEY" 2>/dev/null | grep -E '^(ssh|ecdsa)-' | head -1)
  else
    pub=$(cat "$FLEET_KEY.pub" 2>/dev/null | grep -E '^(ssh|ecdsa)-' | head -1)
    [ -n "$pub" ] || pub=$(ssh-keygen -y -f "$FLEET_KEY" 2>/dev/null | head -1)
  fi
  [ -n "$pub" ] || die "could not read the public key out of $FLEET_KEY"
  echo "$pub" > "$FLEET_KEY.pub"; chmod 644 "$FLEET_KEY.pub"
  cat <<EOF

--- copy the line below (all of it, one line) -------------------------------
$pub
-----------------------------------------------------------------------------

Next: authorize it on the mesh — ONE paste, no per-node steps.

  1. Router GUI -> Administration -> System -> "SSH Authentication key"
  2. Paste the line above on its OWN line, keeping any keys already there.
  3. Apply.

AiMesh syncs that field byte-for-byte to every node, current AND future, so
every node accepts this key without being touched individually. fleetctl does
not write it for you on purpose: authorized-keys is the one setting that can
lock you out of your own mesh, so it stays a human action in the GUI.
(Side effect: the router authorizes its own key. Harmless.)

Then:  fleetctl discover   ->  paste FLEET_NODES into $CONF  ->  fleetctl nodes
EOF
}

cmd_discover() {
  # The mesh membership list lives in the CONTROLLER's nvram, so discovery
  # always asks the controller — locally when fleetctl runs on it, over SSH
  # when it runs on a workstation. One code path; `self` just happens to be a
  # transport that needs no network.
  AUTODETECTED=0
  if [ -z "$FLEET_CONTROLLER" ]; then
    # Nothing configured: try to find the router instead of making the user do
    # it. The LAN's default gateway is the obvious candidate, but a guess is
    # only accepted once the host itself confirms what it is — so we ask, and
    # we say out loud what we found.
    _gw=$(_default_gateway)
    if [ -n "$_gw" ]; then
      echo "No FLEET_CONTROLLER set — checking the default gateway ($_gw)..."
      if _looks_like_controller "$_gw"; then
        FLEET_CONTROLLER=$_gw; AUTODETECTED=1
        echo "Found an ASUS unit there: $AUTO_MODEL. Using it as the controller."
        echo
      else
        die "could not use the default gateway ($_gw) as the AiMesh controller: $AUTO_REASON

If you normally reach this router through an SSH ALIAS (a Host block in
~/.ssh/config supplying the user and key), auto-detection cannot see that — it
only has the bare address. Name the alias instead:
  FLEET_CONTROLLER=\"router\"             # whatever your Host block is called
or set the address plus a user:
  FLEET_CONTROLLER=\"$_gw\"
  FLEET_USER=\"<router admin username>\"
Either goes in $CONF. If SSH auth itself is the problem, authorize your key on
the router first (see README)."
      fi
    else
      die "discovery asks the AiMesh controller, and this machine is not one.
Could not work out this LAN's default gateway either (no ip/route/netstat?).
Set the controller in $CONF:
  FLEET_CONTROLLER=\"192.168.1.1\"        # or a Host alias from ~/.ssh/config
Discovery is only a convenience — you can also just write FLEET_NODES by hand."
    fi
  fi
  _parse_spec "$FLEET_CONTROLLER"
  CTRL_LOCAL=$SPEC_LOCAL; CTRL_NAME=$SPEC_NAME
  _raw=$(_run_on "$FLEET_PROBE_TIMEOUT" 'nvram get cfg_device_list' 2>/dev/null)
  # Prefer the line that looks like the list (a login banner may precede it),
  # but fall back to the last non-empty line so an UNRECOGNISED value still
  # reaches the parser and gets shown to the user rather than silently dropped.
  raw=$(echo "$_raw" | grep '>' | head -1)
  [ -n "$raw" ] || raw=$(echo "$_raw" | grep -v '^[[:space:]]*$' | tail -1)
  if [ -z "$raw" ]; then
    echo "No AiMesh device list came back from the controller ($CTRL_NAME)."
    echo
    echo "Most likely there is simply no mesh here — a single router reports no"
    echo "device list. It can also mean that unit is not the AiMesh controller,"
    echo "that this firmware keeps the list elsewhere, or that fleetctl could not"
    echo "reach it (try: fleetctl --nodes '$FLEET_CONTROLLER' nodes)."
    echo
    # Key off the CONTROLLER's transport, not the platform: "the controller is
    # this machine" is exactly when `self` is the right advice.
    if [ "$CTRL_LOCAL" = "1" ]; then
      echo "For a single router, you do not need to configure anything at all:"
      echo "fleetctl acts on this unit when no fleet is set. To be explicit, put"
      echo "this in $CONF:"
      echo
      echo '  FLEET_NODES="self"'
    else
      echo "For a single router, point fleetctl straight at it in $CONF:"
      echo
      echo "  FLEET_NODES=\"$FLEET_CONTROLLER\""
    fi
    exit 1
  fi
  # Format (verified on 3006): records '<'-separated, fields '>'-separated:
  #   <hostname>ip>mac>role   —  role 1 = the controller itself, 0 = a node.
  # Parse DEFENSIVELY: firmware generations differ within one mesh (3004 nodes
  # under a 3006 controller are in the field), so an unrecognised shape must
  # print the raw value and hand over to manual config, never hard-fail.
  # NB: the parse loop is fed by a heredoc, NOT wrapped in $( … ) — bash 3.2
  # (macOS, where this repo's `sh -n` lint runs) mis-parses a `case` inside a
  # command substitution. Keep case statements out of $( ).
  # The nodes come back as bare IPs, and on a workstation a bare IP does NOT
  # inherit the ~/.ssh/config Host block that makes the CONTROLLER reachable —
  # so probing them would fail auth even though the mesh is fine (observed live
  # 2026-07-28). The controller knows the answer: AiMesh syncs the admin
  # username to every unit (verified 2026-07-22), so ask for it and use it.
  DISCOVERED_USER=""
  if [ -z "$FLEET_USER" ]; then
    DISCOVERED_USER=$(_run_on "$FLEET_PROBE_TIMEOUT" 'nvram get http_username' 2>/dev/null |
                      grep -v '^[[:space:]]*$' | tail -1 | tr -dc 'A-Za-z0-9._-')
    if [ -n "$DISCOVERED_USER" ]; then
      FLEET_USER=$DISCOVERED_USER
      echo "Using the mesh admin username from the controller: $FLEET_USER"
      echo
    fi
  fi

  cands=""
  _recs=$(echo "$raw" | tr '<' '\n')
  while IFS='>' read -r h ip mac role _rest; do
    case "$ip" in ''|*[!0-9.]*) continue ;; esac      # field 2 must look like an IP
    # role 1 = the controller (it lists itself; NOT necessarily first — order
    # carries no meaning, only the role field does). It is a legitimate fleet
    # member: the addon usually wants to run on every unit, controller included.
    cands="$cands$ip|${h:-node}|$(echo "$mac" | tr 'a-z' 'A-Z')|${role:-0}
"
  done <<EOF
$_recs
EOF
  if [ -z "$cands" ]; then
    echo "fleetctl could not parse any node out of cfg_device_list."
    # The controller also keeps a plain node COUNT. Quoting it turns "I got
    # nothing" into "I should have found N" — the difference between a user
    # thinking they have no mesh and knowing the parser is at fault.
    _rc2=$(_run_on "$FLEET_PROBE_TIMEOUT" 'nvram get cfg_recount' 2>/dev/null | tr -dc '0-9')
    [ -n "$_rc2" ] && [ "$_rc2" != "0" ] &&
      echo "(the controller reports cfg_recount=$_rc2, so it believes it has $_rc2 node(s) — this is a parsing gap, please report the raw value below)"
    echo
    echo "raw value (unrecognised format — please report it):"
    echo "  $raw"
    echo
    echo "Populate $CONF by hand instead:"
    echo '  FLEET_NODES="192.168.1.2 192.168.1.3"'
    exit 1
  fi
  echo "fleetctl $VERSION — AiMesh nodes known to this controller:"
  echo
  specline=""
  # A read-loop (not `for c in $cands`) so a node name containing a space cannot
  # split into two bogus rows — and fed by a heredoc rather than a pipe, so the
  # loop runs in THIS shell and $specline survives it.
  while IFS='|' read -r ip label mac role; do
    [ -n "$ip" ] || continue
    label=$(echo "$label" | tr ' ,' '__')             # specs are whitespace-free
    # If the controller is the machine we are running on, target it as `self`:
    # local execution needs no key authorized on itself and no network hop.
    # From a workstation it is just another SSH target like any node.
    if [ "$role" = "1" ] && [ "$CTRL_LOCAL" = "1" ]; then
      spec="self,name=$label"; shown="self ($ip)"
    elif [ -n "$mac" ]; then
      spec="$ip,mac=$mac,name=$label"; shown="$ip"
    else
      spec="$ip,name=$label"; shown="$ip"
    fi
    _parse_spec "$spec"
    tag=""; [ "$role" = "1" ] && tag=" [controller]"
    if _probe; then
      if _eligible; then
        printf '  %-16s %-14s %-10s auth: ok    merlin: yes  (run + install)%s\n' "$shown" "$label" "$P_MODEL" "$tag"
      else
        printf '  %-16s %-14s %-10s auth: ok    merlin: no   (run only)%s\n' "$shown" "$label" "$P_MODEL" "$tag"
      fi
    else
      printf '  %-16s %-14s %-10s auth: FAIL  %s\n' "$shown" "$label" "-" "$(echo "$P_REASON" | cut -c1-60)"
    fi
    specline="$specline$spec "
  done <<EOF
$cands
EOF
  _userline=""
  [ -n "$DISCOVERED_USER" ] && _userline="FLEET_USER=\"$DISCOVERED_USER\"
"
  cat <<EOF

Paste this into $CONF:
$_userline
FLEET_NODES="$(echo "$specline" | sed 's/ *$//')"

Notes on that line:
  - The mac= pins are not decoration. FLEET_NODES holds addresses, DHCP moves
    addresses, and 'install'/'push' run as root on whatever answers. fleetctl
    verifies the pin before anything mutating and refuses a mismatch.
  - The [controller] entry is included because an addon usually wants to run on
    every unit, itself included. Delete it if you only want the nodes.
EOF
}

cmd_nodes() {
  _nodes_or_die
  # `nodes` is the natural "what does my fleet look like" query, so it is the
  # one a consuming addon most wants to parse. Its porcelain form is a WIDER
  # row than the fan-out summary — it answers questions the summary cannot
  # (model, eligibility, pin state) — so it carries its own leading tag:
  #   fleetctl-node<TAB>name<TAB>reachable|unreachable<TAB>model<TAB>eligible|ineligible<TAB>pin<TAB>detail
  # Same rule as the summary contract: columns are append-only, never reordered.
  if [ "$PORCELAIN" != "1" ]; then
    echo "fleetctl $VERSION — configured nodes (default user: ${FLEET_USER:-<from ~/.ssh/config>}, port: $FLEET_PORT):"
    echo
  fi
  rc=0
  for spec in $FLEET_NODES; do
    _parse_spec "$spec"
    if _probe; then
      _pinstate="unpinned"
      if [ -n "$SPEC_MAC" ]; then _pin_matches && _pinstate="pin ok" || { _pinstate="PIN MISMATCH"; rc=1; }; fi
      _self=""; _is_self && _self=" [controller]"
      _elig=ineligible; _eligible && _elig=eligible
      if [ "$PORCELAIN" = "1" ]; then
        printf 'fleetctl-node\t%s\treachable\t%s\t%s\t%s\t%s\n' \
          "$SPEC_NAME" "$P_MODEL" "$_elig" "$(echo "$_pinstate" | tr ' ' '-')" "${_self# }"
      elif [ "$_elig" = "eligible" ]; then
        printf '  %-18s %-10s auth: ok    merlin: yes  %s%s\n' "$SPEC_NAME" "$P_MODEL" "$_pinstate" "$_self"
      else
        printf '  %-18s %-10s auth: ok    merlin: no   %s%s  (run only)\n' "$SPEC_NAME" "$P_MODEL" "$_pinstate" "$_self"
      fi
    else
      if [ "$PORCELAIN" = "1" ]; then
        printf 'fleetctl-node\t%s\tunreachable\t\t\t\t%s\n' "$SPEC_NAME" "$P_REASON"
      else
        printf '  %-18s %-10s auth: FAIL  %s\n' "$SPEC_NAME" "-" "$P_REASON"
      fi
      rc=1
    fi
  done
  exit $rc
}

cmd_run() {
  [ -n "$1" ] || die "usage: fleetctl run <command...>"
  _nodes_or_die
  _lock
  cmdstr="$*"
  [ "$DRY_RUN" = "1" ] && echo "DRY RUN — nothing will be executed."
  echo "fleetctl $VERSION — running on every configured node:"
  echo "  \$ $cmdstr"
  out="$TMPBASE.out"
  for spec in $FLEET_NODES; do
    _parse_spec "$spec"
    echo
    echo "=== $SPEC_NAME ($(_target_desc)) ==="
    if ! _require_target 0; then
      echo "  $GATE_REASON"
      [ "$GATE" = "skip" ] && _result "$SPEC_NAME" SKIPPED "$GATE_REASON" || _result "$SPEC_NAME" FAIL "$GATE_REASON"
      continue
    fi
    if [ "$DRY_RUN" = "1" ]; then
      echo "  would run: $cmdstr"
      _result "$SPEC_NAME" SKIPPED "dry run"
      continue
    fi
    # Buffered per node (in /tmp = RAM, never /jffs = flash): a pipeline would
    # hide the remote exit status, and busybox sh has no PIPESTATUS. Serial and
    # deterministic — meshes are 2-4 units, and the router is also routing.
    _run_on "$FLEET_RUN_TIMEOUT" "$cmdstr" > "$out" 2>&1; s=$?
    [ -s "$out" ] && sed "s/^/[$SPEC_NAME] /" "$out"
    if [ "$TIMED_OUT" = "1" ]; then
      _result "$SPEC_NAME" FAIL "timed out after ${FLEET_RUN_TIMEOUT}s (FLEET_RUN_TIMEOUT)"
    elif [ "$s" = "0" ]; then
      _result "$SPEC_NAME" OK "exit 0"
    else
      _result "$SPEC_NAME" FAIL "exit $s"
    fi
  done
  _print_summary
}

cmd_push() {
  src=$1; dest=$2
  [ -n "$src" ] && [ -n "$dest" ] || die "usage: fleetctl push <local-file> <remote-path>"
  [ -f "$src" ] || die "no such file: $src"
  case "$dest" in /*) : ;; *) die "remote path must be absolute: $dest" ;; esac
  case "$dest" in *\'*) die "remote path must not contain a single quote" ;; esac
  _nodes_or_die
  _lock
  # `cat | ssh 'cat > tmp && mv'` rather than scp: it needs only cat on the far
  # side (no scp/sftp binary, no dropbear scp quirks), and the temp+mv makes the
  # replacement atomic so an interrupted push cannot leave a half-written file
  # in place of a working one.
  mode=644; [ -x "$src" ] && mode=755
  [ "$DRY_RUN" = "1" ] && echo "DRY RUN — nothing will be written."
  echo "fleetctl $VERSION — pushing $src -> $dest (mode $mode)"
  _confirm_fanout "overwrite $dest (mode $mode) — any existing file there is replaced"
  for spec in $FLEET_NODES; do
    _parse_spec "$spec"
    echo
    echo "=== $SPEC_NAME ($(_target_desc)) ==="
    if ! _require_target 1; then
      echo "  $GATE_REASON"
      [ "$GATE" = "skip" ] && _result "$SPEC_NAME" SKIPPED "$GATE_REASON" || _result "$SPEC_NAME" FAIL "$GATE_REASON"
      continue
    fi
    if [ "$DRY_RUN" = "1" ]; then
      # Dry run is read-only, so it can afford to LOOK: "would create" and
      # "would overwrite" are very different sentences to a prod operator.
      _ex=$(_run_on "$FLEET_PROBE_TIMEOUT" "[ -e '$dest' ] && echo overwrite || echo create" 2>/dev/null | tr -dc 'a-z')
      _sz=$(wc -c < "$src" | tr -d ' ')
      case "$_ex" in
        overwrite) echo "  would OVERWRITE existing $dest (mode $mode, $_sz bytes)" ;;
        *)         echo "  would create $dest (mode $mode, $_sz bytes)" ;;
      esac
      _result "$SPEC_NAME" SKIPPED "dry run"
      continue
    fi
    # The temp name is generated HERE (our pid) rather than remotely: the
    # destination path has to be single-quoted for the remote shell, and a
    # remote $$ inside single quotes would never expand. The lock guarantees
    # only one fleetctl is pushing at a time, so our pid is unique enough.
    rtmp="$dest.fleetctl.$$"
    rcmd="cat > '$rtmp' && chmod $mode '$rtmp' && mv '$rtmp' '$dest'"
    RUN_STDIN="$src"                      # see _with_timeout: async stdin is /dev/null
    _run_on "$FLEET_RUN_TIMEOUT" "$rcmd" > "$TMPBASE.out" 2>&1; s=$?
    RUN_STDIN=/dev/null
    [ -s "$TMPBASE.out" ] && sed "s/^/[$SPEC_NAME] /" "$TMPBASE.out"
    if [ "$TIMED_OUT" = "1" ]; then _result "$SPEC_NAME" FAIL "timed out after ${FLEET_RUN_TIMEOUT}s"
    elif [ "$s" = "0" ]; then _result "$SPEC_NAME" OK "wrote $dest"
    else _result "$SPEC_NAME" FAIL "exit $s"; fi
  done
  _print_summary
}

cmd_install() {
  url=$1; shift
  [ -n "$url" ] || die "usage: fleetctl install <installer-url> [args...]"
  case "$url" in
    http://*|https://*) : ;;
    *) die "installer must be an http(s) URL: $url" ;;
  esac
  case "$url" in *\'*) die "URL must not contain a single quote" ;; esac
  _nodes_or_die
  # Installing FLEETCTL onto a local target would rewrite this very script while
  # busybox sh is still reading it incrementally — undefined behavior, and the
  # reason `update` exists (it execs the installer from /tmp first). Catch the
  # foot-gun rather than documenting it and hoping.
  case "$url" in
    *fleetctl*)
      for _s in $FLEET_NODES; do
        _parse_spec "$_s"
        [ "$SPEC_LOCAL" = "1" ] && die "that looks like fleetctl's own installer, and '$SPEC_RAW' is this machine — installing over a running script is undefined. Use 'fleetctl update' for self, and remove 'self' from FLEET_NODES to push fleetctl to the others."
      done ;;
  esac
  _lock
  args="$*"
  [ "$DRY_RUN" = "1" ] && echo "DRY RUN — nothing will be installed."
  echo "fleetctl $VERSION — installing on every eligible node:"
  echo "  url:  $url"
  [ -n "$args" ] && echo "  args: $args"
  _confirm_fanout "download and RUN this installer as root: $url${args:+ $args}"
  # Download to a file and run it, rather than curl|sh: it separates "download
  # failed" from "install failed", and it leaves the installer's stdin free
  # (an installer arriving ON stdin cannot read stdin — see the addon contract
  # in the README).
  for spec in $FLEET_NODES; do
    _parse_spec "$spec"
    echo
    echo "=== $SPEC_NAME ($(_target_desc)) ==="
    if ! _require_target 1; then
      echo "  $GATE_REASON"
      [ "$GATE" = "skip" ] && _result "$SPEC_NAME" SKIPPED "$GATE_REASON" || _result "$SPEC_NAME" FAIL "$GATE_REASON"
      continue
    fi
    if [ "$DRY_RUN" = "1" ]; then
      echo "  would run: curl -fsSL '$url' -o /tmp/… && sh /tmp/… $args"
      _result "$SPEC_NAME" SKIPPED "dry run"
      continue
    fi
    rcmd="t=/tmp/fleetctl-install.\$\$.sh; curl -fsSL '$url' -o \"\$t\" || { echo 'fleetctl: installer download failed (does this node have internet access?)'; exit 90; }; sh \"\$t\" $args; _rc=\$?; rm -f \"\$t\"; exit \$_rc"
    _run_on "$FLEET_INSTALL_TIMEOUT" "$rcmd" > "$TMPBASE.out" 2>&1; s=$?
    # NEVER reduce a node to a checkmark: an addon can install cleanly, exit 0,
    # and still be silently inert — the installer's own tail is the only place
    # that shows. Swallowing it turns one silent misconfiguration into N
    # invisible ones, all self-reporting success.
    [ -s "$TMPBASE.out" ] && sed "s/^/[$SPEC_NAME] /" "$TMPBASE.out"
    if [ "$TIMED_OUT" = "1" ]; then _result "$SPEC_NAME" FAIL "timed out after ${FLEET_INSTALL_TIMEOUT}s (FLEET_INSTALL_TIMEOUT)"
    elif [ "$s" = "0" ]; then _result "$SPEC_NAME" OK "installer exited 0"
    elif [ "$s" = "90" ]; then _result "$SPEC_NAME" FAIL "could not download the installer"
    else _result "$SPEC_NAME" FAIL "installer exited $s"; fi
  done
  echo
  echo "Read the per-node output above, not just the summary: an installer can"
  echo "exit 0 and still have landed in an inert configuration."
  _print_summary
}

cmd_health() {
  rc=0
  ok()   { echo "  ok:   $1"; }
  bad()  { echo "  FAIL: $1"; rc=1; }
  note() { echo "  warn: $1"; }
  echo "fleetctl $VERSION health check"

  if [ "$PLATFORM" = "router" ]; then
    ok "running on the router ($(nvram get productid 2>/dev/null))"
    [ "$(nvram get jffs2_scripts 2>/dev/null)" = "1" ] && ok "JFFS custom scripts enabled" || bad "JFFS custom scripts disabled (nvram jffs2_scripts)"
    [ -n "$FLEET_CONTROLLER" ] && ok "discovery source: $FLEET_CONTROLLER" || note "no FLEET_CONTROLLER — 'discover' has nothing to ask"
  else
    ok "running on a workstation (config: $CONF)"
    # jffs2_scripts is a property of each TARGET, not of this machine — checking
    # it locally here would be meaningless, and failing on it would be wrong.
    if [ -n "$FLEET_CONTROLLER" ]; then ok "discovery source: $FLEET_CONTROLLER"
    else note "FLEET_CONTROLLER unset — 'discover' cannot ask anyone; set it or write FLEET_NODES by hand"; fi
  fi
  # NB: no `command` builtin on this busybox — probe with `which`
  if _detect_ssh; then
    ok "SSH client: $SSH_BIN ($SSH_FLAVOR)"
    [ "$SSH_FLAVOR" = "dropbear" ] && { [ "$DB_HAS_K" = "1" ] && ok "dbclient keepalive (-K) supported" || note "dbclient has no -K: a node that dies mid-command relies on the watchdog alone"; }
  else
    bad "no SSH client found (dbclient/ssh) — fan-out impossible"
  fi
  if which dropbearkey >/dev/null 2>&1; then ok "key generation: dropbearkey"
  elif which ssh-keygen >/dev/null 2>&1; then ok "key generation: ssh-keygen"
  else note "neither dropbearkey nor ssh-keygen — 'fleetctl keygen' cannot generate a key here"; fi
  which curl >/dev/null 2>&1 && ok "curl available (needed by 'update')" || note "curl missing — 'update' will not work"
  [ -d "$FLEET_HOME/.ssh" ] && ok "known_hosts dir: $FLEET_HOME/.ssh" || note "no $FLEET_HOME/.ssh yet (created on first connection)"

  if [ -f "$CONF" ]; then
    sh -n "$CONF" 2>/dev/null && ok "conf parses: $CONF" || bad "conf has syntax errors: $CONF"
  else
    note "no conf at $CONF — using built-in defaults"
  fi

  if [ -f "$FLEET_KEY" ]; then
    ok "key present: $FLEET_KEY"
    case "$(ls -l "$FLEET_KEY" 2>/dev/null | cut -c1-10)" in
      -rw-------) ok "key permissions are 0600" ;;
      *) note "key is group/other-readable — chmod 600 $FLEET_KEY" ;;
    esac
    [ -f "$FLEET_KEY.pub" ] && ok "public key present: $FLEET_KEY.pub" || note "no $FLEET_KEY.pub — run 'fleetctl keygen' to re-derive it"
  elif [ "$FLEET_ALLOW_PASSWORD" = "1" ]; then
    note "no key ($FLEET_KEY) — falling back to the discouraged password path"
  elif [ "$PLATFORM" = "workstation" ]; then
    # Not a failure off-router: OpenSSH may well authenticate from an agent or
    # a ~/.ssh/config Host block, which is the nicest workstation setup there is.
    note "no fleetctl key ($FLEET_KEY) — relying on your own ~/.ssh (agent or Host config)"
  else
    bad "no key at $FLEET_KEY and FLEET_ALLOW_PASSWORD=0 — run 'fleetctl keygen'"
  fi
  [ "$FLEET_ALLOW_PASSWORD" = "1" ] && note "FLEET_ALLOW_PASSWORD=1 — password auth permitted; it is never stored, but it does transit process environments"
  [ "$FLEET_STRICT_HOSTKEY" = "1" ] && ok "strict host-key checking on" || note "unknown host keys are accepted on first contact (TOFU); a CHANGED key is always refused"

  if [ -z "$FLEET_NODES" ]; then
    note "FLEET_NODES is empty — run 'fleetctl discover' for a conf-ready line"
  else
    ok "nodes configured: $FLEET_NODES"
    for spec in $FLEET_NODES; do
      _parse_spec "$spec"
      if _probe; then
        _p=""; [ -n "$SPEC_MAC" ] && _p=", pin ok"
        if [ -n "$SPEC_MAC" ] && ! _pin_matches; then
          bad "$SPEC_NAME: MAC pin does not match the host answering at $SPEC_HOST — 'install'/'push' will refuse it"
        elif _is_self && [ "$INCLUDE_SELF" != "1" ]; then
          note "$SPEC_NAME: this is the controller itself — excluded from fan-out unless --include-self"
        elif _eligible; then
          ok "$SPEC_NAME ($P_MODEL): auth ok, Merlin-eligible$_p"
        else
          note "$SPEC_NAME: auth ok, NOT Merlin-eligible$_p — $(_ineligible_reason)"
        fi
        [ -z "$SPEC_MAC" ] && note "$SPEC_NAME: no mac= pin — 'install'/'push' will refuse it (re-run 'fleetctl discover' for a pinned line)"
      else
        bad "$SPEC_NAME: $P_REASON"
      fi
    done
  fi

  if [ $rc -eq 0 ]; then echo "healthy."; else echo "PROBLEMS FOUND — see FAIL lines above."; fi
  exit $rc
}

cmd_update() {
  echo "fleetctl $VERSION — fetching the latest installer from GitHub (main)..."
  # ?cb= busts the raw.githubusercontent.com CDN cache (the query string is
  # part of its cache key). raw still lags a push by up to ~5 min regardless,
  # so a "nothing changed" result right after a push means wait, not broken.
  curl -fsSL "$REPO_RAW/install.sh?cb=$(date +%s)" -o "$UPDATE_TMP" ||
    die "download failed — does the router have internet access?"
  # exec, don't run-and-return: the installer overwrites THIS script, and
  # busybox sh reads scripts incrementally, so a running script must never have
  # its file rewritten under it. exec replaces this process with the installer
  # (running from RAM) first.
  exec sh "$UPDATE_TMP"
}

cmd_uninstall() {
  echo "Removing fleetctl from this router."
  echo
  echo "REMINDER — fleetctl cannot undo trust it never created:"
  echo "  the public key you pasted into the GUI is still authorized on this"
  echo "  router and on every mesh node. Remove it in the router GUI"
  echo "  (Administration -> System -> SSH Authentication key) if you are done"
  echo "  with it; AiMesh propagates the removal to the nodes."
  echo
  echo "  Addons installed on nodes are NOT removed. Roll those back first:"
  echo "    fleetctl install <installer-url> uninstall"
  echo
  rm -f "$FLEET_KEY" "$FLEET_KEY.pub" "$CONF" "$UPDATE_TMP"
  rm -rf "$FLEET_HOME"
  logger -t "$TAG" "uninstalled" 2>/dev/null
  echo "fleetctl uninstalled (key, conf, known_hosts, and tool removed)."
  rm -f "$0"
}

usage() {
  cat <<EOF
fleetctl $VERSION — AiMesh fleet orchestration for Asuswrt-Merlin

usage: fleetctl [flags] <verb> [args]

verbs:
  keygen [--force]         create a client keypair, print the pubkey to paste
                           (optional: point FLEET_KEY at an existing key instead)
  discover                 list AiMesh nodes this controller knows about
  nodes                    status of every node configured in fleetctl.conf
  run <command...>         run a command on every node (read-only gate)
  push <local> <remote>    copy a file to every eligible node (atomic)
  install <url> [args...]  run an addon installer on every eligible node;
                           args pass through, so rollback is:
                             fleetctl install <url> uninstall
  health                   self-check (non-zero exit on any FAIL)
  update                   self-update from GitHub (main)
  uninstall                remove fleetctl from this router

flags (before the verb):
  --dry-run                probe and report, execute nothing
  --nodes "<spec> ..."     override FLEET_NODES for this invocation
  --include-self           include the controller in the fan-out (off by default)
  --allow-unpinned         let mutating verbs target nodes with no mac= pin

node spec:  [user@]host[:port][,key=value]...  |  self
            fields: port= user= key=<file> auth=pass|key mac=<pin> name=<label>
            e.g.    192.168.1.2,mac=AA:BB:CC:DD:EE:FF,name=node1
                    admin@node2.lan:2222,key=/jffs/scripts/node2.key
                    router                     (a Host alias from ~/.ssh/config)
                    self                       (this machine, run locally)

running on: $PLATFORM
config:     $CONF
EOF
}

# --- dispatcher -------------------------------------------------------------
# Global flags come BEFORE the verb, so that everything after `run` / `install`
# belongs to the remote command and is never eaten by our own parser.
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)        DRY_RUN=1; shift ;;
    --include-self)   INCLUDE_SELF=1; shift ;;
    --allow-unpinned) ALLOW_UNPINNED=1; shift ;;
    --porcelain)      PORCELAIN=1; shift ;;
    --yes|-y)         ASSUME_YES=1; shift ;;
    --nodes)          [ -n "$2" ] || die "--nodes needs a value"; FLEET_NODES=$2; shift 2 ;;
    -v|--version)     echo "fleetctl $VERSION"; exit 0 ;;
    -h|--help)        usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown flag: $1  (flags go before the verb; see 'fleetctl' for usage)" ;;
    *)  break ;;
  esac
done

# --- library mode -----------------------------------------------------------
# `FLEETCTL_LIB=1 . /jffs/scripts/fleetctl` loads the plumbing WITHOUT running a
# verb, for addons that want to build their own mesh commands on it. The stable
# surface is the fleet_* wrappers below; the _underscore functions are internal
# and may change between releases.
fleet_version()  { echo "$VERSION"; }
fleet_platform() { echo "$PLATFORM"; }
fleet_list()     { echo "$FLEET_NODES"; }
fleet_spec()     { _parse_spec "$1"; }              # -> SPEC_HOST/PORT/USER/MAC/NAME/LOCAL
fleet_probe()    { _probe; }                        # -> P_MODEL/P_JFFS/P_DIR/P_MACS/P_REASON
fleet_eligible() { _eligible; }                     # after fleet_probe
fleet_gate()     { _require_target "$1"; }          # 1 = mutating -> GATE/GATE_REASON
fleet_exec()     { _run_on "$1" "$2"; }             # <seconds> <command>
if [ -n "${FLEETCTL_LIB:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

VERB=$1
case "$VERB" in
  keygen)    shift; cmd_keygen "$@" ;;
  setup)     shift; cmd_keygen "$@" ;;   # pre-0.2 name, still accepted
  discover)  cmd_discover ;;
  nodes)     cmd_nodes ;;
  run)       shift; cmd_run "$@" ;;
  push)      shift; cmd_push "$@" ;;
  install)   shift; cmd_install "$@" ;;
  health)    cmd_health ;;
  update)    cmd_update ;;
  uninstall) cmd_uninstall ;;
  version|-v|--version) echo "fleetctl $VERSION" ;;
  *) usage; exit 1 ;;
esac
